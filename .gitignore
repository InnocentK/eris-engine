# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.venv
venv/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Eris runtime output — machine-specific, may contain repo content
runs/
# scorer output: derived, regenerable per key epoch; NEVER under runs/ -
# the gate's collision check treats any entry there as a run id, and runs/
# is RunWriter's domain (redacted, hashed, append-only)
summaries/
cache/
eval/corpus/*/snapshot/
eval/snapshots/
*.last_message.json

# claude-code machine-local settings
.claude/settings.local.json

# Machine-specific executable pins written by `eris policy pin`
policies/pins.yaml
policies/pin-state/
reviews/*/snapshot/
